---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>gloam</h1>
			<p class="lede">
				데이터베이스와 데이터 파이프라인의 내부 동작을 파고든 기록입니다. 장애를 추적한 과정, 실행
				계획이 이상하게 풀린 이유, 스토리지 엔진이 실제로 디스크에 무엇을 쓰는지 같은 것들을
				다룹니다.
			</p>
			<p>
				결론만 적기보다 <strong>거기까지 간 경로</strong>를 남기려고 합니다. 가설을 어떻게 세웠고
				무엇으로 반증했는지, 재현 방법과 실측값을 함께 씁니다.
			</p>

			<h2>최근 글</h2>
			{
				posts.length === 0 ? (
					<p class="empty">아직 발행한 글이 없습니다. 첫 글을 쓰는 중입니다.</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li>
								<a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</li>
						))}
					</ul>
				)
			}
			<p><a href={withBase('/blog')}>글 목록 전체 보기 →</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lede {
		font-size: 1.15em;
		line-height: 1.7;
	}
	.empty {
		color: rgb(var(--gray));
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.post-list li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5em;
		padding: 0.6em 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.post-list .date {
		color: rgb(var(--gray));
		font-size: 0.9em;
		white-space: nowrap;
	}
</style>
