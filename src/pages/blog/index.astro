---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { withBase } from '../../utils/url';

// draft 글은 목록에 노출하지 않는다. 개별 URL로는 접근 가능해 미리보기는 된다.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 연도별로 묶어 시간 흐름이 보이게 한다.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getFullYear();
	if (!byYear.has(year)) byYear.set(year, []);
	byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`글 목록 · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>글 목록</h1>
			{
				posts.length === 0 ? (
					<p class="empty">아직 발행한 글이 없습니다.</p>
				) : (
					years.map((year) => (
						<section class="year-group">
							<h2 class="year">{year}</h2>
							<ul class="posts">
								{byYear.get(year)!.map((post) => (
									<li>
										<a class="row" href={withBase(`/blog/${post.id}/`)}>
											<span class="title">{post.data.title}</span>
											<span class="date">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</a>
										{post.data.description && (
											<p class="desc">{post.data.description}</p>
										)}
										{post.data.tags.length > 0 && (
											<ul class="tags">
												{post.data.tags.map((tag) => (
													<li class="tag">{tag}</li>
												))}
											</ul>
										)}
									</li>
								))}
							</ul>
						</section>
					))
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.empty {
		color: var(--text-muted);
	}
	.year-group {
		margin-top: 2.5em;
	}
	.year {
		font-size: 1em;
		font-weight: 800;
		letter-spacing: -0.02em;
		margin: 0 0 0.8em 0;
		padding-bottom: 0.5em;
		border-bottom: 1px solid var(--border);
	}
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts > li {
		padding: 1.1em 0;
		border-bottom: 1px solid var(--border);
	}
	.posts > li:last-child {
		border-bottom: none;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.4em 1em;
		text-decoration: none;
		color: inherit;
	}
	.title {
		font-size: 1.1em;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--text-strong);
		line-height: 1.45;
	}
	/* 호버는 한 번에 하나뿐이라 초록의 밝기가 그대로 장점이 된다 */
	.row:hover .title,
	.row:hover .date {
		color: var(--accent-meta);
	}
	.date {
		font-size: 0.85em;
		white-space: nowrap;
	}
	.desc {
		margin: 0.45em 0 0 0;
		color: var(--text-muted);
		font-size: 0.92em;
		line-height: 1.65;
	}
	.tags {
		margin-top: 0.7em;
	}

	@media (max-width: 720px) {
		.row {
			flex-direction: column;
			gap: 0.25em;
		}
	}
</style>
