---
import { SITE_TITLE } from '../consts';
import { withBase } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href={withBase('/')}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/OmbraBB" target="_blank" rel="me noopener">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href={withBase('/rss.xml')}>
				<span class="sr-only">RSS</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M2 2.5a.5.5 0 0 1 .5-.5C9.404 2 15 7.596 15 14.5a.5.5 0 0 1-1 0C14 8.149 8.851 3 2.5 3a.5.5 0 0 1-.5-.5zm0 4a.5.5 0 0 1 .5-.5A8.5 8.5 0 0 1 11 14.5a.5.5 0 0 1-1 0A7.5 7.5 0 0 0 2.5 7a.5.5 0 0 1-.5-.5zm0 6a2 2 0 1 1 4 0 2 2 0 0 1-4 0z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	/*
	  오로라는 여기에만 건다. 헤더는 페이지당 한 번뿐이라
	  아무리 세게 해도 반복되지 않고, 그래서 소음이 되지 않는다.
	*/
	header {
		position: relative;
		margin: 0;
		padding: 0 1em;
		background: var(--bg-elevated);
		overflow: hidden;
	}
	/* 헤더 뒤에 걸리는 빛 */
	header::before {
		content: '';
		position: absolute;
		inset: -120% 0 auto 0;
		height: 260%;
		pointer-events: none;
		background:
			radial-gradient(
				60% 55% at 22% 78%,
				color-mix(in srgb, var(--accent-meta) 22%, transparent) 0%,
				transparent 70%
			),
			radial-gradient(
				55% 50% at 72% 82%,
				color-mix(in srgb, var(--accent) 26%, transparent) 0%,
				transparent 70%
			);
		filter: blur(26px);
	}
	/* 초록에서 보라로 넘어가는 띠. 두 색이 만나는 지점이 오로라의 얼굴이다. */
	header::after {
		content: '';
		position: absolute;
		inset: auto 0 0 0;
		height: 2px;
		background: linear-gradient(
			to right,
			transparent 0%,
			var(--accent-meta) 18%,
			var(--accent) 55%,
			color-mix(in srgb, var(--accent) 40%, transparent) 78%,
			transparent 100%
		);
	}
	nav {
		position: relative;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	/*
	  로고만 픽셀 폰트. 라틴 전용이라 본문에는 쓸 수 없다.
	  글자에 오로라를 흘린다. background-clip이 안 먹는 브라우저에서는
	  color 값이 그대로 보이므로 글자가 사라지지 않는다.
	*/
	h2 a,
	h2 a.active {
		text-decoration: none;
		font-family: var(--font-pixel), monospace;
		font-size: 1.7em;
		letter-spacing: 0.06em;
		color: var(--text-strong);
		background: linear-gradient(
			100deg,
			var(--accent-meta) 0%,
			var(--text-strong) 45%,
			var(--accent) 100%
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		transition: filter 0.15s ease;
	}
	/* 글자색이 투명이라 color로는 호버를 못 준다. 밝기로 준다. */
	h2 a:hover {
		filter: brightness(1.3);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--text);
		border-bottom: 3px solid transparent;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--accent);
	}
	.social-links a {
		color: var(--text-muted);
	}
	.social-links a:hover {
		color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
