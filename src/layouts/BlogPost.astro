---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

// about.astro처럼 컬렉션 밖에서도 이 레이아웃을 쓰므로 스키마 기본값 필드는 선택으로 둔다.
type Props = Omit<CollectionEntry<'blog'>['data'], 'draft' | 'tags'> & {
	draft?: boolean;
	tags?: string[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	draft = false,
	tags = [],
} = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} image={heroImage} noindex={draft} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--text);
			}
			.title {
				margin-bottom: 2em;
				padding-bottom: 1.2em;
				border-bottom: 1px solid var(--border);
			}
			.title h1 {
				margin: 0 0 0.4em 0;
			}
			.draft-badge {
				display: inline-block;
				margin-bottom: 0.7em;
				color: var(--accent-meta);
				font-size: 0.85em;
				font-weight: 800;
				letter-spacing: 0.02em;
			}
			.draft-badge::before {
				content: '● ';
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.5em 1em;
				color: var(--text-muted);
				font-size: 0.88em;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						{draft && <span class="draft-badge">초안</span>}
						<h1>{title}</h1>
						<div class="meta">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="last-updated-on">
										수정 <FormattedDate date={updatedDate} />
									</span>
								)
							}
							{
								tags.length > 0 && (
									<ul class="tags">
										{tags.map((tag) => (
											<li class="tag">{tag}</li>
										))}
									</ul>
								)
							}
						</div>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
